{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "leetcode-streak-guardian-scheduler",
  "main": "src/index.js",
  "compatibility_date": "2026-11-13",

  // Every 10 minutes from 04:00 to 23:50 UTC = 09:30 to 05:20 IST.
  // Cron Triggers always run in UTC.
  "triggers": {
    "crons": ["*/10 4-23 * * *"]
  },

  // Change these if the repository, workflow file, or branch is renamed.
  "vars": {
    "GITHUB_OWNER": "aryankinha",
    "GITHUB_REPO": "leetcode-streak-guardian",
    "GITHUB_WORKFLOW": "guardian.yml",
    "GITHUB_REF": "main"
  },

  "observability": {
    "enabled": true
  }
}
