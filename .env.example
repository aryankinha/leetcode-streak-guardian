# Required
LEETCODE_USERNAME=your_leetcode_username
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Optional: required for verified recommendations.
# Copy these from a signed-in leetcode.com browser session. Without them the
# bot still recommends, but cannot confirm which problems you already solved.
LEETCODE_SESSION=
LEETCODE_CSRFTOKEN=

# Optional: local scheduler interval in minutes (1-59, default 10)
CHECK_INTERVAL=10
